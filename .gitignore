.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.idea/
*.iml
.env
android/local.properties
android/key.properties
*.jks

# CI / local build outputs. The Android workflow writes the signed APKs to out/ (~300 MB) and
# tees its own logs next to the sources; none of it belongs in Git. The generated android/
# platform folder is recreated by the workflow on every run (flutter create + branding overlay).
out/
*.apk
*.aab
analyze.txt
test.txt
build-apk.txt
render.txt
intro.txt
badging.txt
shots/
android/

# Owner uploads used as build inputs (the shipped art is generated from them; the sources stay out of Git).
tool/inputs/

# Python bytecode from the asset/team builders.
__pycache__/

# The tracked v9 bytecode file is kept (it predates this rule); new bytecode stays out.
!tool/__pycache__/build_fs_assets.cpython-312.pyc
